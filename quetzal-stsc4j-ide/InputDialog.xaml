<Window x:Class="Editor1.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False">
    <Border Background="#2A2A3E" CornerRadius="8" BorderBrush="#6C63FF" BorderThickness="1"
            Padding="24,20" MinWidth="350">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Título" FontSize="16" FontWeight="SemiBold"
                       Foreground="#CCCCDD" Margin="0,0,0,12"/>
            <TextBlock x:Name="PromptText" Text="Ingrese valor:" FontSize="12"
                       Foreground="#8888AA" Margin="0,0,0,8"/>
            <TextBox x:Name="ResponseTextBox" FontSize="13"
                     Background="#1E1E2E" Foreground="#CCCCDD"
                     BorderBrush="#3A3A5E" BorderThickness="1"
                     Padding="8,6" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="BtnCancel_Click"
                        Background="#3A3A5E" Foreground="#AAAACC" BorderThickness="0"
                        Padding="16,6" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="Aceptar" Click="BtnOk_Click" IsDefault="True"
                        Background="#6C63FF" Foreground="White" BorderThickness="0"
                        Padding="16,6" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
