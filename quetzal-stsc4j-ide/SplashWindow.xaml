<Window x:Class="Editor1.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Height="350" Width="550"
        Topmost="True">
    <Border Background="#1E1E2E" CornerRadius="16" BorderBrush="#6C63FF" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Icon -->
                <Border Width="80" Height="80" CornerRadius="40" Background="#6C63FF" Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Q" FontSize="42" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Quetzal" FontSize="36" FontWeight="Bold" Foreground="#6C63FF"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Source to Source Compiler 4J" FontSize="16" Foreground="#AAAACC"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="40,0,40,30">
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#6C63FF" Background="#2A2A3E"
                             BorderThickness="0"/>
                <TextBlock Text="Loading..." FontSize="11" Foreground="#666688"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
