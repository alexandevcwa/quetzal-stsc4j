<Window x:Class="Editor1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Editor1"
        mc:Ignorable="d"
        Title="Quetzal Source to Source Compiler 4J"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- TreeView style -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="0" Background="#2A2A3E" BorderBrush="#3A3A5E" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <!-- Left: Project actions -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BtnOpenProject" Content="📂 Abrir Proyecto" Click="BtnOpenProject_Click"
                            Style="{StaticResource {x:Type Button}}"
                            Background="#3A3A5E" Foreground="#CCCCDD" BorderThickness="0"
                            Padding="12,6" Margin="2" FontSize="12" Cursor="Hand"/>
                </StackPanel>

                <!-- Right: Action buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSave" Content="💾 Guardar" Click="BtnSave_Click"
                            Background="#3A3A5E" Foreground="#CCCCDD" BorderThickness="0"
                            Padding="12,6" Margin="2" FontSize="12" Cursor="Hand"/>
                    <Button x:Name="BtnRun" Content="▶ Correr" Click="BtnRun_Click"
                            Background="#3A3A5E" Foreground="#88CC88" BorderThickness="0"
                            Padding="12,6" Margin="2" FontSize="12" Cursor="Hand"/>
                    <Button x:Name="BtnCompile" Content="⚙ Compilar" Click="BtnCompile_Click"
                            Background="#3A3A5E" Foreground="#88AAFF" BorderThickness="0"
                            Padding="12,6" Margin="2" FontSize="12" Cursor="Hand"/>
                    <Button x:Name="BtnTransform" Content="🔄 Transformar" Click="BtnTransform_Click"
                            Background="#3A3A5E" Foreground="#FFAA55" BorderThickness="0"
                            Padding="12,6" Margin="2" FontSize="12" Cursor="Hand"/>
                    <Button x:Name="BtnGenerateJava" Content="☕ Generar Java" Click="BtnGenerateJava_Click"
                            Background="#3A3A5E" Foreground="#FF8866" BorderThickness="0"
                            Padding="12,6" Margin="2" FontSize="12" Cursor="Hand"/>
                    <Button x:Name="BtnPackage" Content="📦 Empaquetar" Click="BtnPackage_Click"
                            Background="#3A3A5E" Foreground="#CC88FF" BorderThickness="0"
                            Padding="12,6" Margin="2" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- === FILE EXPLORER === -->
            <Border Grid.Column="0" Background="#252536" BorderBrush="#3A3A5E" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Explorer header -->
                    <Border Grid.Row="0" Background="#2A2A3E" Padding="10,8">
                    <TextBlock Text="EXPLORADOR" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8888AA"/>
                    </Border>

                    <!-- Explorer toolbar -->
                    <Border Grid.Row="1" Background="#2A2A3E" Padding="4,2" BorderBrush="#3A3A5E" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📄+" ToolTip="Nuevo Archivo" Click="BtnNewFile_Click"
                                    Background="Transparent" Foreground="#CCCCDD" BorderThickness="0"
                                    Padding="6,4" Margin="1" FontSize="13" Cursor="Hand"/>
                            <Button Content="📁+" ToolTip="Nueva Carpeta" Click="BtnNewFolder_Click"
                                    Background="Transparent" Foreground="#CCCCDD" BorderThickness="0"
                                    Padding="6,4" Margin="1" FontSize="13" Cursor="Hand"/>
                            <Button Content="✏️" ToolTip="Renombrar" Click="BtnRename_Click"
                                    Background="Transparent" Foreground="#CCCCDD" BorderThickness="0"
                                    Padding="6,4" Margin="1" FontSize="13" Cursor="Hand"/>
                            <Button Content="🗑️" ToolTip="Eliminar" Click="BtnDelete_Click"
                                    Background="Transparent" Foreground="#FF6666" BorderThickness="0"
                                    Padding="6,4" Margin="1" FontSize="13" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- TreeView -->
                    <TreeView x:Name="FileTree" Grid.Row="2" Background="Transparent" BorderThickness="0"
                              Padding="4" SelectedItemChanged="FileTree_SelectedItemChanged"
                              MouseDoubleClick="FileTree_MouseDoubleClick">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontSize="14"/>
                                    <!-- Normal display -->
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"/>
                                    <!-- Edit mode -->
                                    <TextBox x:Name="RenameBox" Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}"
                                             Background="#3A3A5E" Foreground="#CCCCDD" BorderThickness="1"
                                             BorderBrush="#6C63FF" Padding="2,0" MinWidth="100"
                                             KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- No project message -->
                    <TextBlock x:Name="NoProjectLabel" Grid.Row="2"
                               Text="No hay proyecto abierto.&#x0a;Haga clic en 'Abrir Proyecto'."
                               Foreground="#555577" FontSize="12" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="20"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="3" Background="#3A3A5E"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- === EDITOR + OUTPUT === -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- Tab control for open files -->
                <TabControl x:Name="EditorTabs" Grid.Row="0" Background="#1E1E2E"
                            BorderThickness="0" Padding="0"
                            SelectionChanged="EditorTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#2A2A3E"/>
                            <Setter Property="Foreground" Value="#AAAACC"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,1,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder" Background="#2A2A3E" Padding="10,6"
                                                BorderBrush="Transparent" BorderThickness="0,2,0,0" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Header}" Foreground="#AAAACC" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="✕" Tag="{Binding}"
                                                        Click="CloseTab_Click"
                                                        Background="Transparent" Foreground="#666688"
                                                        BorderThickness="0" Padding="6,0,0,0" FontSize="11"
                                                        VerticalAlignment="Center" Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#1E1E2E"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6C63FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                </TabControl>

                <!-- Welcome message when no tabs open -->
                <Border x:Name="WelcomePanel" Grid.Row="0" Background="#1E1E2E" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Q" FontSize="60" FontWeight="Bold" Foreground="#3A3A5E"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Quetzal Editor" FontSize="20" Foreground="#3A3A5E"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Abra un proyecto o archivo para comenzar" FontSize="12"
                                   Foreground="#444466" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Splitter horizontal -->
                <GridSplitter Grid.Row="1" Height="3" Background="#3A3A5E"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS"/>

                <!-- === OUTPUT LOG === -->
                <Border Grid.Row="2" Background="#1A1A28" BorderBrush="#3A3A5E" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2A2A3E" Padding="10,6">
                            <DockPanel>
                                <TextBlock Text="SALIDA" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#8888AA" VerticalAlignment="Center"/>
                                <Button Content="🗑 Limpiar" Click="BtnClearOutput_Click"
                                        DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Background="Transparent" Foreground="#666688" BorderThickness="0"
                                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                            </DockPanel>
                        </Border>

                        <TextBox x:Name="OutputLog" Grid.Row="1"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#1A1A28" Foreground="#88CC88"
                                 BorderThickness="0" Padding="10,6"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2" Background="#6C63FF" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Listo" Foreground="White" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusProjectPath" Text="" Foreground="#DDDDFF" FontSize="11"
                           DockPanel.Dock="Right" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
