<UserControl x:Class="quetzal_stsc4j_ui.Components.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource ExplorerBgLight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header del Explorador -->
        <Border Grid.Row="0" 
                Background="{StaticResource ExplorerBgLight}" 
                BorderBrush="{StaticResource ExplorerBorderColor}" 
                BorderThickness="0,0,0,1"
                Padding="10,10,10,10">
            <TextBlock Text="EXPLORADOR DE SOLUCIONES" 
                       Foreground="{StaticResource ExplorerTextMuted}" 
                       FontSize="11" FontWeight="Bold"/>
        </Border>

        <!-- TreeView con Tema Claro -->
        <TreeView x:Name="FileExplorer" Grid.Row="1" 
                  Background="{StaticResource ExplorerBgDark}"
                  BorderThickness="0" 
                  Foreground="{StaticResource ExplorerTextNormal}"
                  SelectedItemChanged="FileExplorer_SelectedItemChanged"
                  Style="{StaticResource ExplorerTreeViewStyle}"
                  Padding="5">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource ExplorerTreeViewItemStyle}">
                    <Setter Property="Foreground" Value="{StaticResource ExplorerTextNormal}"/>
                    <Style.Resources>
                        <!-- Colores de selección para tema claro -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3F2FD"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0D47A1"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F5F5F5"/>
                    </Style.Resources>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>