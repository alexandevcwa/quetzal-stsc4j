<UserControl x:Class="quetzal_stsc4j_ui.Components.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgLight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="EXPLORADOR DE SOLUCIONES" 
                   Foreground="{StaticResource TextMuted}" 
                   FontSize="11" FontWeight="Bold" Margin="10,10,0,10"/>

        <TreeView x:Name="FileExplorer" Grid.Row="1" 
                  Background="Transparent"
                  BorderThickness="0" 
                  Foreground="{StaticResource TextNormal}">
        </TreeView>
    </Grid>
</UserControl>