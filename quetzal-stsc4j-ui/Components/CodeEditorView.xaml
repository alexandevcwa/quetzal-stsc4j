<UserControl x:Class="quetzal_stsc4j_ui.Components.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDark}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="5">
            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold">
                <Run x:Name="FileNameRun" Text="Sin guardar"/>
            </TextBlock>
        </Border>

        <TextBox x:Name="EditorTexto" Grid.Row="1"
                 Background="{StaticResource BgDark}"
                 Foreground="{StaticResource TextNormal}"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="14"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="10"
                 Text="// Quetzal Java Compiler - Code Editor"
                 TextChanged="EditorTexto_TextChanged"/>
    </Grid>
</UserControl>