<UserControl x:Class="quetzal_stsc4j_ui.Components.OutputPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Background="{StaticResource BgLight}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderColor}">
        <TabItem Header="Salida de Compilación">
            <TextBox x:Name="CompileOutput"
                     Background="{StaticResource BgDark}"
                     Foreground="#CCCCCC"
                     FontFamily="Consolas"
                     BorderThickness="0"
                     IsReadOnly="True"
                     Padding="5"
                     VerticalScrollBarVisibility="Auto"
                     Text="Quetzal Compiler Initialized..."/>
        </TabItem>

        <TabItem Header="Terminal">
            <Grid x:Name="TerminalContainer" Background="#0C0C0C"/>
        </TabItem>
    </TabControl>
</UserControl>