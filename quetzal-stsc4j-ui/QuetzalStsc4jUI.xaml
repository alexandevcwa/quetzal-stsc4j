<Window x:Class="quetzal_stsc4j_ui.QuetzalStsc4jUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quetzal Source to Source Compiler for Java" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#D4D4D4">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgLight" Color="#252526"/>
        <SolidColorBrush x:Key="BgSelection" Color="#3E3E42"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="TextNormal" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="TextMuted" Color="#CCCCCC"/>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="19" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander" 
                                  ClickMode="Press" 
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                  Foreground="{StaticResource TextNormal}"/>

                            <Border x:Name="Bd" Grid.Column="1" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Padding="{TemplateBinding Padding}" 
                            SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="PART_Header" 
                                          ContentSource="Header" 
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="false">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" SourceName="Bd" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgSelection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#2D2D30" Foreground="{StaticResource TextNormal}" Padding="5">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="Archivo">
                <MenuItem Header="Abrir Archivo..." Click="BtnOpenFile_Click"/>
                <MenuItem Header="Abrir Directorio..." Click="BtnOpenFolder_Click"/>
                <Separator Background="{StaticResource BorderColor}"/>
                <MenuItem Header="Guardar" InputGestureText="Ctrl+S" Click="BtnSave_Click"/>
                <Separator Background="{StaticResource BorderColor}"/>
                <MenuItem Header="Salir"/>
            </MenuItem>
            <MenuItem Header="Editar"/>
            <MenuItem Header="Ver"/>
            <MenuItem Header="Ayuda"/>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="5">
            <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource ModernBtn}" ToolTip="Compilar">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19.21,12.04L19.21,12.04C19.39,11.37 19.5,10.68 19.5,10C19.5,4.48 15.02,0 9.5,0C4.5,0 0.35,3.62 0,8.4C2.9,8.03 5.37,6.36 6.91,3.95C8.8,6.86 11.83,9 15.42,9.84C15.11,10.74 14.36,11.5 13.38,11.76L11.5,12.25L11.5,19L9.5,19L9.5,12.78L7.62,12.28C4.53,11.47 2.5,8.4 2.5,5.21V5.21C2.5,5.14 2.5,5.07 2.5,5C2.5,8.87 5.63,12 9.5,12C10.74,12 11.9,11.69 12.92,11.14L15.5,18L17.5,18L19.21,12.04Z" 
                              Fill="#4CAF50" Height="14" Width="14" Stretch="Uniform"/>
                        <TextBlock Text=" Compilar" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{StaticResource BorderColor}" Margin="5,0"/>

                <Button Style="{StaticResource ModernBtn}" ToolTip="Ejecutar">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="#68BC71" Height="12" Width="12" Stretch="Uniform"/>
                        <TextBlock Text=" Correr" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ModernBtn}" Click="BtnSave_Click" ToolTip="Guardar (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" 
                              Fill="#D4D4D4" Height="14" Width="14" Stretch="Uniform"/>
                        <TextBlock Text=" Guardar" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ModernBtn}" ToolTip="Empaquetar">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5Z" 
                              Stroke="{StaticResource TextMuted}" StrokeThickness="2" Height="12" Width="12" Stretch="Uniform"/>
                        <TextBlock Text=" Empaquetar" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ModernBtn}" ToolTip="Convertir">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z" 
                              Fill="#007ACC" Height="12" Width="12" Stretch="Uniform"/>
                        <TextBlock Text=" Convertir" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="EditorTexto" Grid.Column="0"
                     Background="{StaticResource BgDark}"
                     Foreground="{StaticResource TextNormal}"
                     BorderThickness="0"
                     FontFamily="Consolas" FontSize="14"
                     AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="10"
                     Text="// Quetzal Java Compiler - Code Editor"/>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BgLight}"/>

            <Grid Grid.Column="2" Background="{StaticResource BgLight}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="EXPLORADOR DE SOLUCIONES" 
                           Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="10,10,0,10"/>

                <TreeView x:Name="FileExplorer" Grid.Row="1" 
          Background="Transparent"
          BorderThickness="0" 
          Foreground="{StaticResource TextNormal}"
          SelectedItemChanged="FileExplorer_SelectedItemChanged">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3E3E42"/>
                            </Style.Resources>
                        </Style>
                    </TreeView.ItemContainerStyle>

                </TreeView>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BgLight}"/>

        <TabControl Grid.Row="4" Background="{StaticResource BgLight}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderColor}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="12,5" Background="Transparent" BorderThickness="0,0,0,2">
                                    <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource TextMuted}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Salida de Compilación">
                <TextBox Background="{StaticResource BgDark}" Foreground="#CCCCCC" 
                         FontFamily="Consolas" BorderThickness="0" IsReadOnly="True" Padding="5"
                         Text="Quetzal Compiler Initialized..."/>
            </TabItem>

            <TabItem Header="Terminal">
                <Grid Background="#0C0C0C">
                    <TextBlock Text="PS Quetzal\Dev> " Foreground="#CCCCCC" FontFamily="Consolas" Margin="5"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="5" Background="{StaticResource AccentColor}" Foreground="White">
            <StatusBarItem Content="Listo"/>
            <StatusBarItem Content="Ln 1, Col 1" HorizontalAlignment="Right"/>
        </StatusBar>
    </Grid>
</Window>