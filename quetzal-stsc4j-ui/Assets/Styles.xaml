<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BgDark" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BgLight" Color="#252526"/>
    <SolidColorBrush x:Key="BgSelection" Color="#3E3E42"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="TextNormal" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="TextMuted" Color="#CCCCCC"/>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextNormal}"/>
    </Style>

    <Style x:Key="ModernBtn" TargetType="Button">
    </Style>

    <Style TargetType="ContextMenu">
    </Style>

    <Style TargetType="MenuItem">
    </Style>

</ResourceDictionary>